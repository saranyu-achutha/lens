# Copy this file to .env and fill in the values. Never commit .env.

# Spotify Web API (developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=IN

# YouTube Data API v3 (console.cloud.google.com). One key, or several separated by commas:
# they are used in order, and when one runs out of daily quota the next takes over.
YOUTUBE_API_KEY=
